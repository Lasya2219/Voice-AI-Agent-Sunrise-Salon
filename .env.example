# ==============================================================================
# Sunrise Salon AI Voice Receptionist - Environment Variables Template
# Copy this file to .env before running: docker compose up
# ==============================================================================

# Database Connection (Neon PostgreSQL or local instance)
DATABASE_URL=postgresql+asyncpg://user:password@host/dbname?sslmode=require

# LiveKit Cloud Credentials
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret

# Groq Cloud API Key (Whisper STT, LLM, Orpheus TTS)
GROQ_API_KEY=gsk_your_groq_api_key

# Backend & Salon Configuration
BACKEND_URL=http://localhost:8000
BUSINESS_SLUG=sunrise-salon
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Frontend Configuration
VITE_API_BASE_URL=http://localhost:8000/api
VITE_BUSINESS_SLUG=sunrise-salon
